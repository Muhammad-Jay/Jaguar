<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Jaguar.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:ProjectDashboardViewModel"
             x:Class="Jaguar.Desktop.Views.ProjectDashboardView">
    
    <Grid>
        <Border
            CornerRadius="15"
            ClipToBounds="True"
            Background="{StaticResource JaguarMainBgGradientBrush}"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch">
           
            <TextBlock Text="{Binding AppState.CurrentProject.Name}" Foreground="{StaticResource JaguarTextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
    
</UserControl>
