<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nodify="clr-namespace:Nodify;assembly=Nodify"
             xmlns:vm="clr-namespace:Jaguar.Desktop.ViewModels"
             xmlns:models="clr-namespace:Jaguar.Desktop.Models"
             xmlns:services="clr-namespace:Jaguar.Desktop.Services"
             xmlns:agents="clr-namespace:Jaguar.Desktop.CustomViews.Nodes.Agents"
             xmlns:connector="clr-namespace:Jaguar.Desktop.CustomViews.Connector"
             xmlns:avalonia="clr-namespace:Nodify.Avalonia;assembly=Nodify.Avalonia"
             xmlns:controls="clr-namespace:Jaguar.Desktop.CustomViews.Controls"
             UseLayoutRounding="False"
             x:DataType="vm:CanvasViewModel"
             x:Class="Jaguar.Desktop.Views.CanvasView">
    
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+T"  Command="{Binding OpenOrchestratorDialogCommand}"/>
    </UserControl.KeyBindings>
    
    <UserControl.Resources>
        <DataTemplate x:Key="RegularAgentTemplate" DataType="vm:FlowNodeViewModel">
                <agents:RegularAgentNodeView/>
        </DataTemplate>

        <DataTemplate x:Key="OrchestratorTemplate" DataType="vm:FlowNodeViewModel">
                <agents:OrchestratorNodeView/>
        </DataTemplate>
        
        <DataTemplate x:Key="PmTemplate" DataType="vm:FlowNodeViewModel">
                <agents:PmNodeView/>
        </DataTemplate>
        
        <services:NodeTemplateSelector 
            x:Key="MyNodeSelector" 
            RegularAgentLayout="{StaticResource RegularAgentTemplate}"
            OrchestratorLayout="{StaticResource OrchestratorTemplate}"
            PmLayout="{StaticResource PmTemplate}"
        />
    </UserControl.Resources>
    
    
  <Grid>

     <ZoomBorder 
         Name="ZoomHost"
         Focusable="True"
         EnablePan="True"
         EnableZoom="True"
         MinZoomX="0.50"
         MinZoomY="0.50"
         MaxZoomY="2.0"
         MaxZoomX="2.0"
         Stretch="Fill"
         EnableAnimations="True"
         ClipToBounds="True"
         VerticalAlignment="Stretch"
         HorizontalAlignment="Stretch"
         ZoomSpeed="1.2"
         MajorGridInterval="5"
         GridBrush="#3A3A3A"
         >
       
         <!-- WORLD SPACE -->
         <controls:GraphPanel
             ClipToBounds="False"
             Name="WorldCanvas"> 
             
             <!-- <controls:GraphPanel.ContextMenu> -->
             <!--     <StaticResource ResourceKey="CanvasContextMenu"/> -->
             <!-- </controls:GraphPanel.ContextMenu> -->

             <ItemsControl ClipToBounds="False" ItemsSource="{Binding Connections}">
                  <ItemsControl.ItemsPanel>
                     <ItemsPanelTemplate>
                          <Grid ClipToBounds="False" />    
                     </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
           
                 <ItemsControl.ItemTemplate>
                     <DataTemplate x:DataType="vm:ConnectionViewModel">
                         <connector:BezierConnection
                             Source="{Binding Source.Position}"
                             Target="{Binding Target.Position}"
                             Stroke="White"
                             StrokeThickness="2"/>
                     </DataTemplate>
                 </ItemsControl.ItemTemplate>
             </ItemsControl>

         
             
             <ItemsControl ClipToBounds="False" ItemsSource="{Binding Nodes}">
                 <ItemsControl.ItemsPanel>
                     <ItemsPanelTemplate>
                         <controls:GraphPanel ClipToBounds="False" />
                     </ItemsPanelTemplate>
                 </ItemsControl.ItemsPanel>
                 
                 <ItemsControl.ItemTemplate>
                     <DataTemplate x:DataType="vm:FlowNodeViewModel">
                         <ContentControl
                             Width="{Binding Size.Width}"
                             Height="{Binding Size.Height}"
                             ClipToBounds="False"
                             Content="{Binding}"
                             ContentTemplate="{StaticResource MyNodeSelector}"/>
                     </DataTemplate>
                 </ItemsControl.ItemTemplate>
             </ItemsControl>

        
         </controls:GraphPanel>
    </ZoomBorder>
      
  </Grid>
    
</UserControl>