<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Jaguar.Desktop.ViewModels"
             xmlns:views="clr-namespace:Jaguar.Desktop.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:SplashScreenViewModel"
             x:Class="Jaguar.Desktop.Views.SplashScreenView">
    
   
    
    <Grid
        VerticalAlignment="Stretch"
        HorizontalAlignment="Stretch"
        Background="{StaticResource JaguarBackgroundSurfaceBrush}">
        
        <Border
            Width="600"
            Height="500"
            CornerRadius="15"
            ClipToBounds="True"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
            
            <ContentControl
            CornerRadius="15"
            Template="{DynamicResource  GlassPanelNeutralTemplate}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            
             <StackPanel
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="20"
                            >
                            
                            <ContentControl 
                                HorizontalAlignment="Center"
                                Template="{StaticResource JaguarLogo}"/>
                            
                            <TextBlock
                                Classes="text-lg"
                                Text="Jaguar, Cognitive Orchestrator."
                                Foreground="{StaticResource JaguarTextPrimaryBrush}" 
                                VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
            
              </StackPanel>
            </ContentControl>
       
        </Border>
    </Grid>
</UserControl>

