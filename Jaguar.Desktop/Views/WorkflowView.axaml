<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Jaguar.Desktop.ViewModels"
             xmlns:panels="clr-namespace:Jaguar.Desktop.CustomViews.Panels"
             xmlns:views="clr-namespace:Jaguar.Desktop.Views"
             xmlns:manuBars="clr-namespace:Jaguar.Desktop.CustomViews.ManuBars"
             x:DataType="viewModels:WorkflowViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Jaguar.Desktop.Views.WorkflowView">
    <Design.DataContext>
        <viewModels:WorkflowViewModel/>
    </Design.DataContext>
    
    <Grid Background="{StaticResource MainBg}"  Margin="0,0,0, 0">
   
        <Border  VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0"
                Width="15" Height="245" Background="#2A2A2A" CornerRadius="10"
                ZIndex="10"/>
   
        <Grid Margin="8, 0, 8,8">
            <Border HorizontalAlignment="Center" VerticalAlignment="Top"
                    Width="500" Height="20" Background="#2A2A2A" CornerRadius="10" Margin="0,-5,0,0" />
   
            <Panel>
                <Path 
                    Fill="{StaticResource CanvasBg}"
                      StrokeThickness="0"
                      Stretch="Fill"
                      Data="{Binding LayoutPath}"
                      >
                   
                </Path>
                
               
   
                <ContentControl>
                    <views:CanvasView/>
                </ContentControl>
            </Panel>
            
            <Grid
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                Width="22"
                Margin="0,0,8,0">
                <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                        BorderThickness="1"
                        BorderBrush="{StaticResource JaguarSurface}"
                        Height="300" Width="22" Background="Transparent" CornerRadius="6" Margin="0, 10,0,0" >
                    
                    <ContentControl
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        CornerRadius="6"
                        Template="{StaticResource GlassPanelTemplate}">
                        
                        <manuBars:RightMenuBarView/>
                    </ContentControl>
                </Border>
                
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        BorderThickness="1"
                        BorderBrush="{StaticResource JaguarSurface}"
                        Height="100" Width="22" Background="Transparent" CornerRadius="6" Margin="0, 10,0,10" >
                    <ContentControl 
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        CornerRadius="6"
                        Template="{StaticResource GlassPanelTemplate}">
                        
                    </ContentControl>
                </Border>
            </Grid>
        </Grid>
        
        <panels:WorkflowSidebarPanel IsVisible="{Binding AppState.IsPanelOpen}" ZIndex="50" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
