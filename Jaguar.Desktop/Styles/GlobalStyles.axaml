<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">
    
    <Style Selector="Button.BtnPrimary">
        <Setter Property="Background" Value="DimGray"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Opacity" Value="0.5"/>
        
        <Style Selector="^[IsPointerOver=True]">
            <Setter Property="Background" Value="Turquoise"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="Turquoise"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
        
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style Selector="Button.MenuBtn">
        <Setter Property="Background" Value="DimGray"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="FontSize" Value="11"/>
        
        <Style Selector="^[IsPointerOver=True]">
            <Setter Property="Background" Value="Turquoise"/>
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="Turquoise"/>
            <Setter Property="Opacity" Value="0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Style>
    
    <Style Selector="Button.WindowControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="8"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Foreground" Value="{DynamicResource JaguarTextPrimaryBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.WindowControl[IsPressed=True]">
        <Setter Property="Background" Value="{StaticResource JaguarSurface}"/>
        <Style Selector="^ /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource JaguarBackgroundSurfaceRaisedBrush}"/>
        </Style>
    </Style>
   
    <Style Selector="Button.WindowControl[IsPointerOver=True]">
        <Setter Property="Background" Value="{StaticResource JaguarSurface}"/>
    </Style>
    
    <Style Selector="Button#CloseButton[IsPointerOver=True] material|MaterialIcon">
        <Setter Property="Foreground" Value="#E81123"/> 
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    
    <Style Selector="Button.WindowControl material|MaterialIcon">
        <Setter Property="Foreground" Value="{DynamicResource JaguarTextPrimaryBrush}"/> 
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    
    <Style Selector="MenuItem.MenuItemClass[IsPointerOver=True]">
        <Setter Property="Background" Value="DarkCyan"/>
    </Style>
    
    <Style Selector="TextBox.Ghost">
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{StaticResource JaguarBackgroundSurfaceBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="Padding" Value="5, 0"/>
        
        <Style Selector="^:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource JaguarAccentPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        
        <Style Selector="^[IsPointerOver=True]">
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource JaguarAccentPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            
            <Style Selector="^ /template/ Border#PART_BorderElement /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
            </Style>
        </Style>
    </Style>
</Styles>
