<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
   <ControlTemplate x:Key="GlassPanelTemplate" TargetType="ContentControl">
       <Panel>
           <Border CornerRadius="{TemplateBinding CornerRadius}" BoxShadow="0 10 30 0 #80000000" >
               <Border.Effect>
                   <BlurEffect Radius="70"/>
               </Border.Effect>
           </Border>

           <Border CornerRadius="{TemplateBinding CornerRadius}" 
                   Background="#25171717"
                   BorderThickness="1.5" 
                   BorderBrush="#40FFFFFF">
               <Border.OpacityMask>
                   <VisualBrush TileMode="Tile" SourceRect="0,0,50,50" DestinationRect="0,0,50,50">
                       <VisualBrush.Visual>
                           <Canvas Width="50" Height="50">
                               <Ellipse Width="1" Height="1" Fill="White" Opacity="0.4" Canvas.Left="5" Canvas.Top="10"/>
                               <Ellipse Width="1.5" Height="1.5" Fill="White" Opacity="0.2" Canvas.Left="25" Canvas.Top="35"/>
                               <Ellipse Width="1" Height="1" Fill="White" Opacity="0.3" Canvas.Left="40" Canvas.Top="5"/>
                           </Canvas>
                       </VisualBrush.Visual>
                   </VisualBrush>
               </Border.OpacityMask>
           </Border>

           <Border CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
               <Border.Background>
                   <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                       <GradientStop Offset="0" Color="#20FFFFFF" />
                       <GradientStop Offset="0.4" Color="#05FFFFFF" />
                       <GradientStop Offset="1" Color="#15FFFFFF" />
                   </LinearGradientBrush>
               </Border.Background>
            
               <ContentPresenter Content="{TemplateBinding Content}"
                                 ContentTemplate="{TemplateBinding ContentTemplate}"/>
           </Border>
       </Panel>
    </ControlTemplate>
    
     <ControlTemplate x:Key="WorkflowGlassPanelTemplate" TargetType="ContentControl">
       <Panel ZIndex="50">
           <Border CornerRadius="{TemplateBinding CornerRadius}" BoxShadow="0 10 30 0 #80000000" >
               <Border.Effect>
                   <BlurEffect Radius="20"/>
               </Border.Effect>
           </Border>
           <Border CornerRadius="{TemplateBinding CornerRadius}" 
                   Background="#25171717"
                   BorderThickness="1.5" 
                   ClipToBounds="True"
                   BorderBrush="#40FFFFFF">
               <Border.OpacityMask>
                   <VisualBrush TileMode="Tile" SourceRect="0,0,50,50" DestinationRect="0,0,50,50">
                       <VisualBrush.Visual>
                           <Canvas Width="50" Height="50">
                               <Ellipse Width="1" Height="1" Fill="White" Opacity="0.4" Canvas.Left="5" Canvas.Top="10"/>
                               <Ellipse Width="1.5" Height="1.5" Fill="White" Opacity="0.2" Canvas.Left="25" Canvas.Top="35"/>
                               <Ellipse Width="1" Height="1" Fill="White" Opacity="0.3" Canvas.Left="40" Canvas.Top="5"/>
                           </Canvas>
                       </VisualBrush.Visual>
                   </VisualBrush>
               </Border.OpacityMask>
           </Border>

           <Border 
               ClipToBounds="True"
               CornerRadius="{TemplateBinding CornerRadius}"
               Padding="{TemplateBinding Padding}">
               <Border.Background>
                   <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                       <GradientStop Offset="0" Color="#20FFFFFF" />
                       <GradientStop Offset="0.4" Color="#05FFFFFF" />
                       <GradientStop Offset="1" Color="#15FFFFFF" />
                   </LinearGradientBrush>
               </Border.Background>
               <ContentPresenter Content="{TemplateBinding Content}"
                                 ContentTemplate="{TemplateBinding ContentTemplate}"/>
           </Border>
       </Panel>
    </ControlTemplate>


    <ControlTemplate x:Key="GlassPanelCyanTemplate" TargetType="ContentControl">
        <Panel>
            <Border CornerRadius="{TemplateBinding CornerRadius}" BoxShadow="0 10 30 0 #80000000" />

            <Border CornerRadius="{TemplateBinding CornerRadius}" 
                    Background="#25001A1A"
                    BorderThickness="1.5" 
                    BorderBrush="#4000FFFF"> <Border.OpacityMask>
                    <VisualBrush TileMode="Tile" SourceRect="0,0,50,50" DestinationRect="0,0,50,50">
                        <VisualBrush.Visual>
                            <Canvas Width="50" Height="50">
                                <Ellipse Width="1" Height="1" Fill="White" Opacity="0.4" Canvas.Left="5" Canvas.Top="10"/>
                                <Ellipse Width="1.5" Height="1.5" Fill="White" Opacity="0.2" Canvas.Left="25" Canvas.Top="35"/>
                                <Ellipse Width="1" Height="1" Fill="White" Opacity="0.3" Canvas.Left="40" Canvas.Top="5"/>
                            </Canvas>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.OpacityMask>
            </Border>

            <Border CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0" Color="#2000FFFF" /> <GradientStop Offset="0.4" Color="#0500FFFF" />
                        <GradientStop Offset="1" Color="#1500FFFF" />
                    </LinearGradientBrush>
                </Border.Background>
         
                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>
            </Border>
        </Panel>
    </ControlTemplate>

    <ControlTemplate x:Key="GlassPanelNeutralTemplate" TargetType="ContentControl">
        <Panel>
            <Border CornerRadius="{TemplateBinding CornerRadius}" BoxShadow="0 10 30 0 #80000000" >
                <Border.Effect>
                    <BlurEffect Radius="20"/>
                </Border.Effect>
            </Border>
            
            <Border CornerRadius="{TemplateBinding CornerRadius}" 
                    Background="#25262626" BorderThickness="1.5" 
                    BorderBrush="#40404040"> <Border.OpacityMask>
                    <VisualBrush TileMode="Tile" SourceRect="0,0,50,50" DestinationRect="0,0,50,50">
                        <VisualBrush.Visual>
                            <Canvas Width="50" Height="50">
                                <Ellipse Width="1" Height="1" Fill="White" Opacity="0.4" Canvas.Left="5" Canvas.Top="10"/>
                                <Ellipse Width="1.5" Height="1.5" Fill="White" Opacity="0.2" Canvas.Left="25" Canvas.Top="35"/>
                                <Ellipse Width="1" Height="1" Fill="White" Opacity="0.3" Canvas.Left="40" Canvas.Top="5"/>
                            </Canvas>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.OpacityMask>
            </Border>

            <Border CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0" Color="#15FFFFFF" /> 
                        <GradientStop Offset="0.4" Color="#05FFFFFF" />
                        <GradientStop Offset="1" Color="#10FFFFFF" />
                    </LinearGradientBrush>
                </Border.Background>
         
                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>
            </Border>
        </Panel>
    </ControlTemplate>
    
    <ControlTemplate x:Key="BorderedTemplate" TargetType="ContentControl">
        <Panel>
            <Border
                Background="{TemplateBinding Background}"
                Padding="{TemplateBinding Padding}"
                CornerRadius="{TemplateBinding CornerRadius}"
                ClipToBounds="{TemplateBinding ClipToBounds}"
                Width="{TemplateBinding Width}"
                Height="{TemplateBinding Height}"
                VerticalAlignment="{TemplateBinding VerticalAlignment}"
                HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                >
                
                <ContentPresenter 
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"/>
            </Border>
        </Panel>
    </ControlTemplate>
    
    <ControlTemplate x:Key="DefaultBorderedTemplate" TargetType="ContentControl">
        <Panel>
            <Border
                Background="{StaticResource MainBg}"
                Padding="8"
                CornerRadius="10"
                ClipToBounds="True"
                Width="{TemplateBinding Width}"
                Height="{TemplateBinding Height}"
                VerticalAlignment="{TemplateBinding VerticalAlignment}"
                HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
            >
                
                <ContentPresenter 
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"/>
            </Border>
        </Panel>
    </ControlTemplate>
    
    <ControlTemplate x:Key="DefaultContextMenuTemplate" TargetType="ContentControl">
        <Panel VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Border
                Background="{StaticResource MainBg}"
                Padding="10"
                CornerRadius="10"
                ClipToBounds="True"
                Margin="0"
                VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
            >
                
               <ScrollViewer
                   ClipToBounds="True"
                   CornerRadius="5"
                   Margin="0"
                   Padding="4"
                   IsHitTestVisible="False"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   VerticalAlignment="Stretch"
                   HorizontalAlignment="Stretch">
                  
                   <ContentPresenter 
                       Content="{TemplateBinding Content}"
                       ContentTemplate="{TemplateBinding ContentTemplate}"/>
                   
               </ScrollViewer>
            </Border>
        </Panel>
    </ControlTemplate>
</ResourceDictionary>
