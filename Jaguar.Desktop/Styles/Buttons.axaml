<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <!-- Add Controls for Previewer Here -->
        </Border>
    </Design.PreviewWith>

    <!-- Base Style -->
    <Style Selector="Button">
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="{StaticResource JaguarSurface}"/>
        <Setter Property="Foreground" Value="{StaticResource JaguarTextPrimary}"/>
    </Style>
    
    <!-- Primary -->
    <Style Selector="Button.btn-primary">
        <Setter Property="Background" Value="{StaticResource JaguarGradiantButtonAccent}"/>
        <Setter Property="Foreground" Value="Black"/>
        
        <Style Selector="^ /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource JaguarGradiantButtonAccent}"/>
        </Style>
    </Style>
    
    <Style Selector="Button.btn-primary[IsPointerOver=True]">
        <Setter Property="Background" Value="{DynamicResource JaguarAccentPrimaryBrush}"/>
        
        <Style Selector="^ /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource JaguarAccentPrimaryBrush}"/>
        </Style>
    </Style>
    
    <!-- Secondary -->
    <Style Selector="Button.btn-secondary">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{StaticResource JaguarTextMuted}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    
    <!-- Ghost -->
    <Style Selector="Button.btn-ghost">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource JaguarTextSecondary}"/>
        
        <Style Selector="^ /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        
        <Style Selector="^[IsPointerOver=True]">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource JaguarAccentPrimaryBrush}"/>
        
            <Style Selector="^ /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
            </Style>
        </Style>
        
        <Style Selector="^.toolbar">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="2,0,0,0"/>
            <Setter Property="CornerRadius" Value="0,8,8,0"/>
            
            <Style Selector="^[IsPointerOver=True]">
                <Setter Property="BorderBrush" Value="{StaticResource JaguarAccentPrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="2,0,0,0"/>
                <Setter Property="CornerRadius" Value="0,8,8,0"/>
            </Style>
        </Style>
        
        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{StaticResource JaguarBackgroundSurfaceRaisedBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource JaguarAccentPrimaryBrush}"/>
        
            <Style Selector="^ /template/ ContentPresenter">
                <Setter Property="Background" Value="{StaticResource JaguarBackgroundSurfaceRaisedBrush}"/>
            </Style>
        </Style>
    </Style>
</Styles>
