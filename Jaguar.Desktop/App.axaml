<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:contents="clr-namespace:Jaguar.Desktop.CustomViews.Dialog.Contents"
             xmlns:contents1="clr-namespace:Jaguar.Desktop.ViewModels.Dialog.Contents"
             xmlns:templates="clr-namespace:Jaguar.Desktop.CustomViews.Templates"
             xmlns:templates1="clr-namespace:Jaguar.Desktop.ViewModels.Templates"
             xmlns:menuItemViewModel="clr-namespace:Jaguar.Desktop.ViewModels.MenuItemViewModel"
             xmlns:menuItemView="clr-namespace:Jaguar.Desktop.CustomViews.MenuItemView"
             xmlns:viewModels="clr-namespace:Jaguar.Desktop.ViewModels"
             xmlns:views="clr-namespace:Jaguar.Desktop.Views"
             x:Class="Jaguar.Desktop.App"
             RequestedThemeVariant="Dark">
    
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/CustomViews/ContextMenus/OrchestratorResources.axaml"/>
                <ResourceInclude Source="/CustomViews/ContextMenus/CanvasContextMenu.axaml"/>
                <ResourceInclude Source="avares://Nodify/Theme.axaml" />
                <ResourceInclude Source="/Resources/NodeResources.axaml"/>
                <ResourceInclude Source="/Styles/GlassTheme.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        
        <Color x:Key="Neutral900">#141414</Color>
        <Color x:Key="Neutral800">#262626</Color>
        <Color x:Key="JaguarCyan">#00FFFF</Color>

        <SolidColorBrush x:Key="Neutral900Brush" Color="{StaticResource Neutral900}"/>
        <SolidColorBrush x:Key="Neutral800Brush" Color="{StaticResource Neutral800}"/>
        
        <SolidColorBrush x:Key="CanvasBg" Color="Black" />
        <SolidColorBrush x:Key="MainBg" Color="#1E1F20"/>
        <SolidColorBrush x:Key="JaguarSurface" Color="#1E1F20" />
        <SolidColorBrush x:Key="JaguarBorder" Color="#444746" />
        <SolidColorBrush x:Key="JaguarAccent" Color="#8AB4F8" />
        <SolidColorBrush x:Key="JaguarTextPrimary" Color="#E3E3E3" />
        <SolidColorBrush x:Key="JaguarTextSecondary" Color="#C4C7C5" />
    
        <LinearGradientBrush x:Key="JaguarSpark" StartPoint="0%,50%" EndPoint="100%,50%">
            <GradientStop Offset="0.0" Color="#4285F4" />
            <GradientStop Offset="0.33" Color="#9B72CB" />
            <GradientStop Offset="0.66" Color="#D96570" />
            <GradientStop Offset="1.0" Color="#F4AF5F" />
        </LinearGradientBrush>
    </Application.Resources>
    
    <Application.Styles>
    
        <avalonia:MaterialIconStyles />
        <FluentTheme />
      
        <StyleInclude Source="Styles/GlobalStyles.axaml"/>
        <StyleInclude Source="Styles/CanvasStyles.axaml"/>
        
        <Style Selector="ScrollBar /template/ Thumb">
            <Setter Property="Background" Value="#3300C8FF"/>
        </Style>
        
        <Style Selector="ContextMenu">
            <Setter Property="Background" Value="{StaticResource Neutral900}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#3E3E3E"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        
        <Style Selector="MenuItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Background" Value="#2A2A2A" /> <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="MenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Background" Value="#333333" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    
        <Style Selector="Separator">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        
    </Application.Styles>
    
    <Application.DataTemplates>
        <DataTemplate DataType="viewModels:CanvasViewModel">
            <views:CanvasView/>
        </DataTemplate>
        
        <DataTemplate DataType="viewModels:WorkflowViewModel">
            <views:WorkflowView/>
        </DataTemplate>
        
        <DataTemplate DataType="contents1:OrchestratorDialogPromptViewModel">
            <contents:OrchestratorDialogPromptView/>
        </DataTemplate>
        
        <DataTemplate DataType="templates1:AgentTemplatesViewModel">
            <templates:AgentTemplatesView/>
        </DataTemplate>
        
        <DataTemplate DataType="menuItemViewModel:SettingsViewModel">
            <menuItemView:SettingsView/>
        </DataTemplate>
    </Application.DataTemplates>
</Application>