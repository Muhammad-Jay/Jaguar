<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:manuBars="clr-namespace:Jaguar.Desktop.CustomViews.ManuBars"
             xmlns:viewModels="clr-namespace:Jaguar.Desktop.ViewModels.Panel"
             x:DataType="viewModels:WorkflowSidebarPanelViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Jaguar.Desktop.CustomViews.Panels.WorkflowSidebarPanel">
    <Panel Width="300" VerticalAlignment="Stretch" Margin="0, 8, 8, 8">
            <Path Fill="Black" 
                  Stretch="Fill" 
                  Data="M0 20C0 8.95431 8.95431 0 20 0H284C295.046 0 304 8.9543 304 20V326.491C304 331.52 306.419 336.241 310.5 339.179C314.581 342.116 317 346.838 317 351.866V686C317 697.046 308.046 706 297 706H20C8.9543 706 0 697.046 0 686V343.858V228.561V20Z"
                  
                  >
                
                <Path.Effect>
                    <DropShadowEffect Color="#141414" BlurRadius="15" Opacity="0.4"/>
                </Path.Effect>
            </Path>
        
        <Grid RowSpacing="40" ColumnSpacing="40" Margin="3,10,16, 7" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" RowDefinitions="Auto, *">
            <manuBars:PanelTabMenuView Grid.Row="0"/>
            <Panel Grid.Row="1">
                <TransitioningContentControl Content="{Binding Content}"/>
            </Panel>
        </Grid>
    </Panel>
</UserControl>
