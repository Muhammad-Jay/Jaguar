<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Jaguar.Desktop.ViewModels"
             xmlns:templates="clr-namespace:Jaguar.Core.Models;assembly=Jaguar.Core"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:ProjectsViewModel"
             x:Class="Jaguar.Desktop.CustomViews.Projects.ProjectsRenderer">
    
    <Border
        CornerRadius="{DynamicResource LargeCornerRadius}"
        Width="275"
        Background="Transparent"
        BorderBrush="{DynamicResource JaguarBackgrounBrush}"
        BorderThickness="1"
        Padding="5"
        ClipToBounds="True"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch">
        
        <ScrollViewer
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Padding="0,0,10,0"
            ClipToBounds="True"
            CornerRadius="{DynamicResource BaseCornerRadius}"
            Background="Transparent"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
               
               <ItemsControl ItemsSource="{Binding  AppState.Projects}">
                   
                   <ItemsControl.ItemsPanel>
                       <ItemsPanelTemplate>
                           <StackPanel Background="Transparent" Spacing="10"/>
                       </ItemsPanelTemplate>
                   </ItemsControl.ItemsPanel>
            
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="templates:Project">
                   
                    <Border Margin="0" 
                            Height="60"
                            Padding="5"
                            PointerPressed="OnPointerPressed"
                            Background="{StaticResource JaguarBackgroundVoidBrush}" 
                            BorderThickness="1"
                            CornerRadius="11"
                            ClipToBounds="True"
                            Cursor="Hand">
                        
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                            </Transitions>
                        </Border.Transitions>
        
                        <Border.Styles>
                            <Style Selector="Border[IsPointerOver=True]">
                                <Setter Property="BorderBrush" Value="{DynamicResource JaguarStateHoverBrush}"/>
                                <Setter Property="Background" Value="{DynamicResource JaguarBackgroundSurfaceBrush}"/>
                            </Style>
                            <Style Selector="Border[IsPointerOver=False]">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </Border.Styles>
                        
                    <Button
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        Padding="6"
                        CornerRadius="{DynamicResource BaseCornerRadius}"
                        CommandParameter="{Binding}"
                        Command="{Binding $parent[UserControl].((viewModels:ProjectsViewModel)DataContext).ProjectClickedCommand}"
                        Background="{DynamicResource JaguarBackgroundVoidHard}"
                        >
                        
                        <!-- Command="{Binding $parent[UserControl].((viewModels:ProjectsViewModel)DataContext).ProjectClickedCommand}" -->
                        
                        <Button.Styles>
                            <Style Selector="Button[IsPointerOver=True]">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style Selector="^ /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </Style>
                            <Style Selector="Button:pressed">
                                <Setter Property="Background" Value="{DynamicResource JaguarBackgroundVoidHard}"/>
                            </Style>
                        </Button.Styles>
                        
                        <Button.Transitions>
                            <Transitions>
                                <BrushTransition Property="BorderBrush" Duration="0:0:0.1"/>
                            </Transitions>
                        </Button.Transitions>
                        
                        <Grid
                            ColumnDefinitions="Auto, *, Auto">
                            <Border>
                                
                            </Border>
                            <StackPanel
                                Grid.Column="1">
                                <TextBlock
                                    Foreground="{DynamicResource JaguarTextSecondaryBrush}"
                                    Classes="text-xs"
                                    FontWeight="SemiBold"
                                    Text="{Binding Name}"/>
                            </StackPanel>
                            <Grid
                                RowDefinitions="Auto, *"
                                Grid.Column="2">
                                <StackPanel
                                    VerticalAlignment="Top"
                                    Margin="1">
                                    <Button
                                        CornerRadius="4"
                                        Padding="0"
                                        Classes="btn-ghost">
                                        <Button.ContextFlyout>
                                            <MenuFlyout
                                            >
                                                <Border
                                                    Width="100"
                                                    Height="200"
                                                    Background="{DynamicResource Neutral900Brush}"
                                                    CornerRadius="{DynamicResource BaseCornerRadius}">
                                                    
                                                </Border>
                                            </MenuFlyout>
                                        </Button.ContextFlyout>
                                        <avalonia:MaterialIcon Kind="MoreVert"
                                                               Classes="text-xs"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource JaguarTextMuted}"
                                                               FontWeight="SemiBold"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        
                    </Button>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
    </Border>
</UserControl>
