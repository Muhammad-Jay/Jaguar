<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:contents="clr-namespace:Jaguar.Desktop.ViewModels.Dialog.Contents"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="contents:OrchestratorDialogPromptViewModel"
             x:Class="Jaguar.Desktop.CustomViews.Dialog.Contents.OrchestratorDialogPromptView">
  <UserControl.Styles>
        <Style Selector="TextBox#PromptArea">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Black"/>
            <Style Selector="^:focus /template/ Border#PART_BorderElement">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Black"/>
            </Style>
            
            <Style Selector="^[IsPointerOver=True]">
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Black"/>
            </Style>
        </Style>
    </UserControl.Styles>

    <ScrollViewer Name="JaguarDialogScroll" 
                  VerticalScrollBarVisibility="Auto">
        
        <Grid RowDefinitions="Auto, *, Auto" 
              Margin="10" 
              MinHeight="300">
            
            <Border Grid.Row="0" Height="50" Margin="0,0,0,10"
                    CornerRadius="8" Background="{StaticResource Neutral800}">
               
            </Border>

            <Border Grid.Row="1" CornerRadius="8" ClipToBounds="True">
                <Grid>
                    <TextBox Name="PromptArea"
                             Text="{Binding Prompt}"
                             AcceptsReturn="True"
                             FontSize="11"
                             Watermark="Ask the Orchestrator any Request..."
                             VerticalAlignment="Stretch"
                             Background="Black"
                             MinHeight="150"
                             Padding="10,10,10,30"/> 
                    <TextBlock Text="{Binding Stats}"
                               FontSize="9"
                               Foreground="DimGray"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Margin="0,0,15,10"
                               IsHitTestVisible="False"/> 
                </Grid>
            </Border>

            <Border Grid.Row="2" Height="50" Margin="0,10,0,0"
                    CornerRadius="8" Background="{StaticResource Neutral800}">
                <Button Command="{Binding ExecuteRequestCommand}"
                        Content="Execute"
                        HorizontalAlignment="Right"
                        Margin="10,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource JaguarTextPrimary}"
                        Background="{StaticResource Neutral900Brush}"
                        CornerRadius="4"
                        Padding="4"
                        /> 
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
