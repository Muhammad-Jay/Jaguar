<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:viewModels="clr-namespace:Jaguar.Desktop.ViewModels.Menus"
             x:DataType="viewModels:LeftBarMenuViewModel"
             x:Class="Jaguar.Desktop.CustomViews.ManuBars.LeftMenuBarView">
    
    <Border 
        BorderThickness="1"
        BorderBrush="{StaticResource JaguarSurface}"
        VerticalAlignment="Stretch"
        HorizontalAlignment="Stretch"
        Background="Transparent" 
        CornerRadius="6" 
        Padding="2, 5, 2, 5">
        
        <ItemsControl
            ItemsSource="{Binding MenuItems}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
            ScrollViewer.VerticalScrollBarVisibility="Auto"
        >
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" Spacing="10" Background="Transparent"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button 
                        HorizontalAlignment="Stretch" 
                        Height="18"
                        Classes="MenuBtn" 
                        CommandParameter="{Binding}"
                        FontSize="10" 
                        FontWeight="Regular"
                        Foreground="DarkGray"
                        Command="{Binding $parent[ItemsControl].((viewModels:LeftBarMenuViewModel)DataContext).OnSelectedMenuChange}"
                    >
                        
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>
