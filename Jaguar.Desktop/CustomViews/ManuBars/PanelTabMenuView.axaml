<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:panel="clr-namespace:Jaguar.Desktop.ViewModels.Panel"
             x:DataType="panel:WorkflowSidebarPanelViewModel"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Name="Root"
             x:Class="Jaguar.Desktop.CustomViews.ManuBars.PanelTabMenuView">
    
    <Border Background="{StaticResource MainBg}" CornerRadius="10" Padding="3">
       <ScrollViewer Background="Transparent" Height="30">
           <ItemsControl
               ItemsSource="{Binding   ItemList}"
               ScrollViewer.HorizontalScrollBarVisibility="Auto" 
               ScrollViewer.VerticalScrollBarVisibility="Disabled"
               >
               <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal"  Background="Transparent" Spacing="10"/>
                  </ItemsPanelTemplate>
               </ItemsControl.ItemsPanel>
               
               <ItemsControl.ItemTemplate>
                   <DataTemplate>
                       <Button
                           Background="{StaticResource JaguarSurface}"
                           CornerRadius="5"
                           Padding="2"
                           Width="30"
                           Height="20"
                           Margin="2, 2, 0, 2"
                           VerticalContentAlignment="Center"
                           HorizontalContentAlignment="Center"
                           CommandParameter="{Binding}"
                           Command="{Binding #Root.((panel:WorkflowSidebarPanelViewModel)DataContext).SelectMenuItemCommand}"
                           >
                           <Button.Styles>
                               <Style Selector="Button[IsPointerOver=True]">
                                   <Setter Property="Background" Value="Cyan"/>
                               </Style>
                           </Button.Styles>
                           <!-- <StackPanel  -->
                          <!--     VerticalAlignment="Center" -->
                          <!--     HorizontalAlignment="Center"  -->
                          <!--     Orientation="Horizontal"> -->
                          <!--      -->
                          <!--     <avalonia:MaterialIcon Kind="{Binding Icon}"  -->
                          <!--                            Width="16"  -->
                          <!--                            Height="16"  -->
                          <!--                            Foreground="White" /> -->
                          <!--                             -->
                          <!--    -->
                          <!-- </StackPanel> -->
                       </Button>
                   </DataTemplate>
               </ItemsControl.ItemTemplate>
           </ItemsControl>
       </ScrollViewer>
   </Border>
</UserControl>
