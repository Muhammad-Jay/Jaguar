<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:viewModels="clr-namespace:Jaguar.Desktop.ViewModels"
                    xmlns:models="clr-namespace:Jaguar.Desktop.Models"
                    x:DataType="viewModels:CanvasViewModel">

    <ContextMenu x:Key="OrchestratorContextMenu" x:DataType="models:FlowNode">
        <MenuItem Header="Execution">
            <MenuItem Header="Run from here" 
                      Command="{Binding OpenAgentDialogCommand}"
                      InputGesture="Ctrl+Enter">
            </MenuItem>
            <MenuItem Header="Debug Node" />
        </MenuItem>

        <Separator/>

        <MenuItem Header="View Prompt Template" Command="{Binding OpenPromptEditorCommand}"/>
        <MenuItem Header="Manage Knowledge Base" />
    
        <Separator/>

        <MenuItem Header="Copy ID"  Foreground="Gray"/>
        <MenuItem Header="Duplicate" />
        <MenuItem Header="Delete" Command="{Binding DeleteSelfCommand}" Foreground="#FF5555"/>
    </ContextMenu>
</ResourceDictionary>