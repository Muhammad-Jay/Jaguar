<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
   <ContextMenu x:Key="ProjectCardContextMenu">
       <ContextMenu.Styles>
           <Style Selector="ContextMenu /template/ ScrollContentPresenter">
               <Setter Property="Background" Value="{DynamicResource Neutral900Brush}"/>
               <Setter Property="Padding" Value="0"/>
               <Setter Property="BorderThickness" Value="0"/>
               <Setter Property="CornerRadius" Value="{DynamicResource BaseCornerRadius}"/>
               <Setter Property="Effect">
                   <Setter.Value>
                       <DropShadowEffect BlurRadius="20" Color="#40000000"/>
                   </Setter.Value>
               </Setter>
           </Style>
           <Style Selector="ContextMenu[IsPointerOver=True] /template/ ScrollContentPresenter">
               <Setter Property="Background" Value="{DynamicResource Neutral900Brush}"/>
               <!-- <Setter Property="Width" Value="200"/> -->
               <!-- <Setter Property="Height" Value="300"/> -->
           </Style>
       </ContextMenu.Styles>
       <Border
           Width="100"
           Height="200"
           Background="{DynamicResource Neutral900Brush}"
           CornerRadius="{DynamicResource BaseCornerRadius}">
                                                    
       </Border>
   </ContextMenu>
</ResourceDictionary>
