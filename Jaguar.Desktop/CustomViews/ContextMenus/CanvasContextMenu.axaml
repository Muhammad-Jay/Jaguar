<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                    xmlns:vm="clr-namespace:Jaguar.Desktop.ViewModels">
    
    <ContextMenu
        x:Key="CanvasContextMenu"
        x:DataType="vm:CanvasViewModel"
        Width="300"
        MaxHeight="500"
        Padding="0"
        Background="Transparent"
        >
        <ContextMenu.Styles>
            <Style Selector="MenuItem[IsPointerOver=True] /template/ ContextMenu">
                <Setter Property="Background" Value="Transparent"/>
            </Style>
        </ContextMenu.Styles>

        <ContextMenu.Template>
            <ControlTemplate>
                <Border 
                    CornerRadius="10"
                    BorderThickness="1"
                    Background="{StaticResource JaguarSurface}"
                    BorderBrush="{StaticResource JaguarSurface}"
                    Width="{TemplateBinding Width}"
                    Padding="{TemplateBinding Padding}">
                          
                    <ScrollViewer VerticalScrollBarVisibility="Auto" AllowAutoHide="True">
                        <ItemsPresenter Name="PART_ItemsPresenter">
                            <ItemsPresenter.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsPresenter.ItemsPanel>
                        </ItemsPresenter>
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </ContextMenu.Template>

        <MenuItem 
            CornerRadius="5"
            Padding="6"
            HorizontalAlignment="Stretch"
            FontSize="10"
            Classes="MenuItemClass"
            Background="{StaticResource MainBg}"
            Header="Add Research Agent">
            <MenuItem.Icon><avalonia:MaterialIcon Kind="SearchWeb" Foreground="Cyan"/></MenuItem.Icon>
        </MenuItem>
        
        <MenuItem 
            CornerRadius="5"
            Padding="6"
            HorizontalAlignment="Stretch"
            FontSize="10"
            Classes="MenuItemClass"
            Background="{StaticResource MainBg}"
            Header="Add Utility Agent">
            <MenuItem.Icon><avalonia:MaterialIcon Kind="Tools" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem 
            CornerRadius="5"
            Padding="6"
            HorizontalAlignment="Stretch"
            FontSize="10"
            Classes="MenuItemClass"
            Background="{StaticResource MainBg}"
            Header="Clear Canvas">
            <MenuItem.Icon><avalonia:MaterialIcon Kind="DeleteVariant" Foreground="Red"/></MenuItem.Icon>
        </MenuItem>
        
        <MenuItem 
            CornerRadius="5"
            Padding="6"
            HorizontalAlignment="Stretch"
            FontSize="10"
            Classes="MenuItemClass"
            Background="{StaticResource MainBg}"
            Header="Add Research Agent">
            <MenuItem.Icon><avalonia:MaterialIcon Kind="SearchWeb" Foreground="Cyan"/></MenuItem.Icon>
        </MenuItem>
        
        <MenuItem 
            CornerRadius="5"
            Padding="6"
            HorizontalAlignment="Stretch"
            FontSize="10"
            Classes="MenuItemClass"
            Background="{StaticResource MainBg}"
            Header="Add Utility Agent">
            <MenuItem.Icon><avalonia:MaterialIcon Kind="Tools" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem 
            CornerRadius="5"
            Padding="6"
            HorizontalAlignment="Stretch"
            FontSize="10"
            Classes="MenuItemClass"
            Background="{StaticResource MainBg}"
            Header="Clear Canvas">
            <MenuItem.Icon><avalonia:MaterialIcon Kind="DeleteVariant" Foreground="Red"/></MenuItem.Icon>
        </MenuItem>
        
        <MenuItem 
            CornerRadius="5"
            Padding="6"
            HorizontalAlignment="Stretch"
            FontSize="10"
            Classes="MenuItemClass"
            Background="{StaticResource MainBg}"
            Header="Add Research Agent">
            <MenuItem.Icon><avalonia:MaterialIcon Kind="SearchWeb" Foreground="Cyan"/></MenuItem.Icon>
        </MenuItem>
        
        <MenuItem 
            CornerRadius="5"
            Padding="6"
            HorizontalAlignment="Stretch"
            FontSize="10"
            Classes="MenuItemClass"
            Background="{StaticResource MainBg}"
            Header="Add Utility Agent">
            <MenuItem.Icon><avalonia:MaterialIcon Kind="Tools" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem 
            CornerRadius="5"
            Padding="6"
            HorizontalAlignment="Stretch"
            FontSize="10"
            Classes="MenuItemClass"
            Background="{StaticResource MainBg}"
            Header="Clear Canvas">
            <MenuItem.Icon><avalonia:MaterialIcon Kind="DeleteVariant" Foreground="Red"/></MenuItem.Icon>
        </MenuItem>
    </ContextMenu>
</ResourceDictionary>