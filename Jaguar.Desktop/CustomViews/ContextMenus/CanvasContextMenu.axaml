<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                    xmlns:vm="clr-namespace:Jaguar.Desktop.ViewModels">
    
    <ContextMenu
        x:Key="CanvasContextMenu"
        x:DataType="vm:CanvasViewModel"
        Width="310"
        MaxHeight="500"
        Background="Transparent"
        CornerRadius="10"
        >
      
        <ContextMenu.Styles>
            <Style Selector="MenuItem">
                <Setter Property="Background" Value="Transparent"/>
            </Style>

            <Style Selector="MenuItem[IsPointerOver=True] /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
            </Style>

            <Style Selector="MenuItem[IsPointerOver=True]">
                <Setter Property="TextBlock.Foreground" Value="Cyan"/>
            </Style>
        </ContextMenu.Styles>

       <ContentControl
           VerticalAlignment="Stretch"
           Width="310"
           BorderThickness="1"
           BorderBrush="{StaticResource Neutral800Brush}"
           CornerRadius="10"
           Padding="10"
           ClipToBounds="True"
           Template="{StaticResource WorkflowGlassPanelTemplate}">
           
           
           <ScrollViewer 
               ClipToBounds="True"
               IsHitTestVisible="False"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               VerticalAlignment="Stretch"
               HorizontalAlignment="Stretch">
               
               <StackPanel Orientation="Vertical" Spacing="5">
                    <MenuItem 
            CornerRadius="5"
            Padding="6"
            HorizontalAlignment="Stretch"
            FontSize="10"
            Background="{StaticResource MainBg}"
            Header="Add Research Agent">
            <MenuItem.Icon><avalonia:MaterialIcon Kind="SearchWeb" Foreground="Cyan"/></MenuItem.Icon>
        </MenuItem>
        
        <MenuItem 
            CornerRadius="5"
            Padding="6"
            HorizontalAlignment="Stretch"
            FontSize="10"
            Background="{StaticResource MainBg}"
            Header="Add Utility Agent">
            <MenuItem.Icon><avalonia:MaterialIcon Kind="Tools" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem 
            CornerRadius="5"
            Padding="6"
            HorizontalAlignment="Stretch"
            FontSize="10"
            Background="{StaticResource MainBg}"
            Header="Clear Canvas">
            <MenuItem.Icon><avalonia:MaterialIcon Kind="DeleteVariant" Foreground="Red"/></MenuItem.Icon>
        </MenuItem>
        
        <MenuItem 
            CornerRadius="5"
            Padding="6"
            HorizontalAlignment="Stretch"
            FontSize="10"
            Background="{StaticResource MainBg}"
            Header="Add Research Agent">
            <MenuItem.Icon><avalonia:MaterialIcon Kind="SearchWeb" Foreground="Cyan"/></MenuItem.Icon>
        </MenuItem>
        
        <MenuItem 
            CornerRadius="5"
            Padding="6"
            HorizontalAlignment="Stretch"
            FontSize="10"
            Background="{StaticResource MainBg}"
            Header="Add Utility Agent">
            <MenuItem.Icon><avalonia:MaterialIcon Kind="Tools" /></MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem 
            CornerRadius="5"
            Padding="6"
            HorizontalAlignment="Stretch"
            FontSize="10"
            Background="{StaticResource MainBg}"
            Header="Clear Canvas">
            <MenuItem.Icon><avalonia:MaterialIcon Kind="DeleteVariant" Foreground="Red"/></MenuItem.Icon>
        </MenuItem>
               </StackPanel>
           </ScrollViewer>
       </ContentControl>
        
    </ContextMenu>
</ResourceDictionary>