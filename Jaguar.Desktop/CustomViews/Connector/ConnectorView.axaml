<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:connections="clr-namespace:Nodify.Avalonia.Connections;assembly=Nodify.Avalonia"
             xmlns:viewModels="clr-namespace:Jaguar.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:ConnectorViewModel"
             x:Class="Jaguar.Desktop.CustomViews.Connector.ConnectorView">
    <!-- ReSharper disable once InconsistentNaming -->
    <connections:Connector
        Name="PART_connectorDot"
        Width="10"
        Height="10"
        Background="White"
        Cursor="Hand"
        Anchor="{Binding Anchor.Position, Mode=TwoWay}"
        IsConnected="{Binding IsConnected}"
        >
       
    </connections:Connector>
</UserControl>
