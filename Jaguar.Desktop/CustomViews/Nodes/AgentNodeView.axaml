<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:FlowNodeViewModel"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:viewModels="clr-namespace:Jaguar.Desktop.ViewModels"
             x:Class="Jaguar.Desktop.CustomViews.Nodes.AgentNodeView"
             >

 <Border CornerRadius="13"
            BorderBrush="#3F3F3F"
            BorderThickness="1"
            Width="240"
            VerticalAlignment="Center" HorizontalAlignment="Center">
     
        <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0.0" Color="#2E2E2E"/>
                <GradientStop Offset="1.0" Color="#222222"/>
            </LinearGradientBrush>
        </Border.Background>

        <StackPanel>
            
            <Border CornerRadius="10,10,0,0" 
                    Padding="12,9"
                    BorderBrush="#3F3F3F"
                    BorderThickness="0,0,0,1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                         <GradientStop Offset="0.0" Color="#3A3A3A" />
                        <GradientStop Offset="1.0" Color="#303030" />
                    </LinearGradientBrush>
                </Border.Background>
                
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <avalonia:MaterialIcon Kind="ServerNetwork" Width="14" Height="14" Foreground="#909090" />
                    
                    <TextBlock Text="DATA PROCESSOR UNIT"
                               Foreground="#C0C0C0"
                               FontSize="10"
                               FontWeight="SemiBold"
                               LetterSpacing="1.5"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
            
            <StackPanel >
                
                <Grid ColumnDefinitions="*,Auto">
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="LOAD AVERAGE" FontSize="9" Foreground="#777777" FontWeight="Medium" LetterSpacing="0.5"/>
                        <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,2,0,0">
                            <TextBlock Text="34.2" FontSize="18" Foreground="#80CBC4" FontWeight="Bold"/> 
                            <TextBlock Text="%" FontSize="10" Foreground="#80CBC4" FontWeight="Medium" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                         <TextBlock Text="LATENCY" FontSize="9" Foreground="#777777" FontWeight="Medium" HorizontalAlignment="Right" LetterSpacing="0.5"/>
                        <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,2,0,0">
                             <TextBlock Text="12" FontSize="18" Foreground="#FFCC80" FontWeight="Bold"/>
                             <TextBlock Text="ms" FontSize="10" Foreground="#FFCC80" FontWeight="Medium" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                         </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,14,0,0" Spacing="4">
                    <DockPanel LastChildFill="False">
                         <TextBlock DockPanel.Dock="Left" Text="BUFFER CAPACITY" FontSize="9" Foreground="#777777" FontWeight="Medium"/>
                         <TextBlock DockPanel.Dock="Right" Text="650 / 1024 MB" FontSize="9" Foreground="#999999"/>
                    </DockPanel>
                    
                    <ProgressBar Value="63" Height="3" 
                                 Background="#353535"
                                 Foreground="#80CBC4"
                                 ShowProgressText="False"
                                 CornerRadius="2"/>
                </StackPanel>

            </StackPanel>

            <Rectangle Height="1" Fill="#353535" Margin="14,0" />

            <StackPanel Spacing="2">
                <DockPanel >
                     <StackPanel Orientation="Horizontal" Spacing="6" DockPanel.Dock="Left">
                        <Border Width="6" Height="6" CornerRadius="3" Background="#66BB6A" VerticalAlignment="Center"/>
                        <TextBlock Text="Online" FontSize="9" Foreground="#A0A0A0"/>
                    </StackPanel>
                    <TextBlock Text="Uptime: 14d 3h" FontSize="9" Foreground="#777777" DockPanel.Dock="Right"/>
                </DockPanel>
                <TextBlock Text="ID: dp-node-x77f2e9" FontSize="8" Foreground="#555555" Margin="12,0,0,0" FontStyle="Italic"/>
            </StackPanel>
            
        </StackPanel>
    </Border>
</UserControl>
