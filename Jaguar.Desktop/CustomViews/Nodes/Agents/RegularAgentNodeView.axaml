<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:Jaguar.Desktop.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="models:FlowNode"
             x:Class="Jaguar.Desktop.CustomViews.Nodes.Agents.RegularAgentNodeView">
    <Border
        Width="100"
        Height="100"
        Name="RegularNode"
        CornerRadius="10"
        Background="#1E1F20"
        BorderThickness="2"
        ClipToBounds="True"
        >
        <Border.Effect>
            <DropShadowEffect Color="#1E1F20" Opacity="0.3"></DropShadowEffect>
        </Border.Effect>
        
    </Border>
</UserControl>
