<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:Jaguar.Desktop.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="models:FlowNode"
             x:Class="Jaguar.Desktop.CustomViews.Nodes.Agents.OrchestratorNodeView">
    <ContentControl
        Template="{StaticResource GlassPanelTemplate}"
        Width="150"
        Height="150">
        
        <Grid>
            <TextBlock Text="Orchestrator" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center" 
                       Foreground="Cyan"/>
        </Grid>
        
    </ContentControl>
</UserControl>
