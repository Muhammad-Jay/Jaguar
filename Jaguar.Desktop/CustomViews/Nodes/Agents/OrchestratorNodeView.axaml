<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:connector="clr-namespace:Jaguar.Desktop.CustomViews.Connector"
             xmlns:viewModels="clr-namespace:Jaguar.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:FlowNodeViewModel"
             ContextMenu="{DynamicResource OrchestratorContextMenu}"
             x:Class="Jaguar.Desktop.CustomViews.Nodes.Agents.OrchestratorNodeView">
    
            <Grid
                PointerPressed="OnPointerPressed"
                PointerMoved="OnPointerMoved"
                PointerReleased="OnPointerReleased"
                Tag="{Binding IsSelected}"
                Width="{Binding Size.Width}"
                Height="{Binding Size.Height}"
                Background="Transparent"
                ClipToBounds="False"
                >
                
                <Grid.Styles>
                    <Style Selector="Grid[Tag=true]">
                        <Setter Property="ZIndex" Value="100"/>
                    </Style>
                </Grid.Styles>
                
                <Panel
                    Name="AnchorPanel"
                    ClipToBounds="False"
                    HorizontalAlignment="Stretch" 
                    VerticalAlignment="Stretch">
            
            <Panel.Styles>
                <Style Selector="Panel#AnchorPanel">
                    <Setter Property="Background" Value="Transparent"/>
                    
                    <Style Selector="^ Border#BorderLine">
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                        <Setter Property="Height" Value="2"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </Style>
            </Panel.Styles>
            
            <Border
                Name="BorderLine"
                />
            
            <ContentControl
                VerticalAlignment="Center"
                HorizontalAlignment="Left"
                x:Name="InputAnchorControl"
                Template="{StaticResource  NodeAnchors}">
                
                <ItemsControl
                    ItemsSource="{Binding Inputs}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,0,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <connector:ConnectorView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
            </ContentControl>
        
            <ContentControl
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                x:Name="OutputAnchorControl"
                Template="{StaticResource  NodeAnchors}">
                
                <ItemsControl
                    ItemsSource="{Binding Outputs}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,0,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <connector:ConnectorView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
            </ContentControl>

        </Panel>
                
                 <Border
                    Name="OrchestratorNode"
                 Width="170"
                 Height="170"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center"
                 Background="Transparent"
                 Tag="{Binding IsSelected}"
                 BorderThickness="4"
                 BorderBrush="{StaticResource MainBg}"
                 CornerRadius="85"
               
                 >
            
                     <Border.Styles>
                         <Style Selector="Border">
                             <Setter Property="BorderBrush" Value="{StaticResource MainBg}"/>
                             <Setter Property="BoxShadow" Value="0 0 0 0 Transparent"/>
                         </Style>
                         <Style Selector="Border[IsPointerOver=True]">
                             <Setter Property="BorderBrush" Value="Cyan"/>
                         </Style>
                         <Style Selector="Border[Tag=true]">
                             <Setter Property="BorderBrush" Value="Cyan"/>
                         </Style>
                     </Border.Styles>

                     <Border.Transitions>
                         <Transitions>
                             <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
                             <BrushTransition Property="BorderBrush" Duration="0:0:0.2"/>
                         </Transitions>
                     </Border.Transitions>

                 
                 <Border
                     Width="170"
                     Height="170"
                     Padding="20"
                     Background="Transparent"
                     CornerRadius="85"
                 >
                     
                     <Border 
                         VerticalAlignment="Stretch"
                         HorizontalAlignment="Stretch"
                         BorderThickness="5"
                         Tag="{Binding IsSelected}"
                         Background="{StaticResource MainBg}"
                         CornerRadius="65"
                     >
                         
                         <Border.Styles>
                             <Style Selector="Border#OrchestratorNode[Tag=true]">
                                 <Setter Property="Background" Value="Cyan"/>
                             </Style>
                         </Border.Styles>
                         
                     </Border>
                 </Border>
             </Border>
                
                <!-- <Popup -->
                <!--     x:Name="NodeMenuPopup" -->
                <!--     Width="250" -->
                <!--     Height="40" -->
                <!--     ZIndex="40" -->
                <!--     Margin="0,-50,0,0" -->
                <!--     IsOpen="{Binding IsSelected}" -->
                <!--     Placement="Top"> -->
