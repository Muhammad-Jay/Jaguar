                <!--     ~1~     VerticalAlignment="Top" @1@ -->
                <!--     ~1~     Width="250" @1@ -->
                <!--     ~1~     Height="40" @1@ -->
                <!--     ~1~     ZIndex="50" @1@ -->
                <!--     ~1~     Margin="0,-30,0,0"/> @1@ -->
                <!--      -->
                <!--     <Border  -->
                <!--         Width="250" -->
                <!--         Height="40" -->
                <!--         BorderThickness="5" -->
                <!--         Tag="{Binding IsSelected}" -->
                <!--         Background="{StaticResource MainBg}" -->
                <!--         CornerRadius="65" -->
                <!--     > -->
                <!--           -->
                <!--         <Border.Styles> -->
                <!--             <Style Selector="Border#OrchestratorNode[Tag=true]"> -->
                <!--                 <Setter Property="Background" Value="Cyan"/> -->
                <!--             </Style> -->
                <!--         </Border.Styles> -->
                <!--           -->
                <!--     </Border> -->
                <!-- -->
                <!-- </Popup> -->
                
            </Grid>
    
</UserControl>
